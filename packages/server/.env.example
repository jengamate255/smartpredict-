// .env.example — copy to .env and fill in values. Do not commit real .env values.
SUPABASE_URL=https://vonkqyiczeqhuqhahsxm.supabase.co
# SUPABASE_SERVICE_KEY= — fill in your service role key from Supabase Settings → API
# SUPABASE_ANON_KEY= — optional client key
PORT=3000
NODE_ENV=development

# OTP settings
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Real money feature flag (default off — paper trading only)
REAL_MONEY_ENABLED=false
